# kingstack: deny everything, allow only the framework. Anything new in ~/.claude is
# untracked until deliberately added here. This directory also holds credentials,
# session transcripts, and caches; the allowlist is the safety boundary.
*
!.gitignore
!README.md
!LICENSE
!CLAUDE.md
!model-routing.md
!pstack-models.md
!pstack-upstream.txt

# mechanisms
!hooks/
!hooks/**
!scripts/
!scripts/**

# my two skills only; every other skill is generated by scripts/sync-pstack.sh
!skills/
!skills/king-mode/
!skills/king-mode/**
!skills/memory-review/
!skills/memory-review/**
skills/king-mode/.history/

# bin/ is machine-specific node symlinks, regenerated by scripts/link-node.sh
bin/

# docs (proposals, design notes)
!docs/
!docs/**

# sweeps registry (one md per unattended check)
!sweeps/
!sweeps/**

# schedules (copied in from ~/Library/LaunchAgents by scripts/install-launchd.sh)
!launchd/
!launchd/**

# never, even if a rule above would match
.credentials.json
.claude.json
*.log
*.bak
*.tmp

# python bytecode
__pycache__/
*.pyc
